<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Left Colored Vertical Accent Strip -->
        <View
            android:id="@+id/vGroupedColorBar"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="#2563EB" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Title: Code + Subject Name -->
            <TextView
                android:id="@+id/tvGroupedSubjectTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PRN315 - Programación de Dispositivos Móviles"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Docente Principal -->
            <TextView
                android:id="@+id/tvGroupedProfessor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Docente: Ing. Nelson Rodríguez"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Badge Sessions Count (Teoría + Lab) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_capsule"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGroupedSessionsCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗓️ 2 sesiones (Teoría + Laboratorio)"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Sessions Details Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_capsule"
                android:padding="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGroupedSessionsDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Lunes: 07:00 AM - 08:40 AM (📘 Teoría - Aula 204)\n• Miércoles: 10:00 AM - 11:40 AM (🔬 Laboratorio - Lab 1)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/border" />

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnGroupedCloneDay"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1.2"
                    android:gravity="center"
                    android:text="📋 Clonar a otro día"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_capsule"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnGroupedEdit"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="0.9"
                    android:gravity="center"
                    android:text="✏️ Editar"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:background="@drawable/bg_pill_capsule"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnGroupedDelete"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="0.9"
                    android:gravity="center"
                    android:text="🗑️ Eliminar"
                    android:textColor="#EF4444"
                    android:textSize="11sp"
                    android:background="@drawable/bg_pill_capsule" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
