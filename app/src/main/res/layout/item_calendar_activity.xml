<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Left Colored Vertical Accent Strip -->
        <View
            android:id="@+id/vActivityColorBar"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="#3B82F6" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Title & Status Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvActivityTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Entrega de Proyecto Móvil"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Completed Badge -->
                <TextView
                    android:id="@+id/tvActivityStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏳ Pendiente"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#F59E0B"
                    android:background="@drawable/bg_pill_capsule"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Location & Notes/Detalles -->
            <TextView
                android:id="@+id/tvActivityLocationAndNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Lugar: Campus Soyapango • Detalles: Enviar reporte en PDF"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Badges Row: Type Badge + Time + Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Type Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_capsule"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvActivityTypeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📝 Tarea"
                        android:textColor="#3B82F6"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Time Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_capsule"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvActivityTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕒 08:00 AM - 10:00 AM"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Date Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_capsule"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvActivityDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗓️ 21-10-2026"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/border" />

            <!-- Action Buttons Row: Check, Edit, Delete -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnToggleCompleted"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1.2"
                    android:gravity="center"
                    android:text="✓ Completar"
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_capsule"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnEditActivity"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="✏️ Editar"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:background="@drawable/bg_pill_capsule"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnDeleteActivity"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🗑️ Eliminar"
                    android:textColor="#EF4444"
                    android:textSize="11sp"
                    android:background="@drawable/bg_pill_capsule" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
