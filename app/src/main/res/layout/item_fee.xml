<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Tira de color vertical indicadora (Verde = Pagada, Ámbar = Pendiente) -->
        <View
            android:id="@+id/vFeeColorBar"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="@color/warning" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Fila superior: Checkbox/Icono, Título y Badge de Estado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivFeeCheck"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="10dp"
                    android:src="@android:drawable/checkbox_off_background"
                    android:tint="@color/text_secondary"
                    android:contentDescription="Estado del pago" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFeeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cuota 01 (Febrero)"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Badge de Estado (Pagada vs Pendiente) -->
                <TextView
                    android:id="@+id/tvFeeStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏳ Pendiente"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#F59E0B"
                    android:background="@drawable/bg_pill_capsule"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Fila de Monto y Fecha límite de Calendario -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFeeAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$105.00"
                    android:textColor="@color/accent"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_pill_capsule"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvFeeDeadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗓️ Límite: 15-02-2026"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Separador sutil -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/border" />

            <!-- Fila de Botones de Acción con Íconos Reconocibles: Marcar Pagada/Pendiente, Editar, Borrar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnToggleFee"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1.3"
                    android:gravity="center"
                    android:text="✓ Marcar Pagada"
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_capsule"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnEditFee"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="✏️ Editar"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_capsule"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnDeleteFee"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🗑️ Borrar"
                    android:textColor="#EF4444"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_capsule" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
