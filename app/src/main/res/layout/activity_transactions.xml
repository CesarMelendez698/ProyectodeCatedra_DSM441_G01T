<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 1. Encabezado Azul Superior (Idéntico a Screenshot 2) -->
    <LinearLayout
        android:id="@+id/appBarTransactions"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:background="@color/header_blue"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Historial de Movimientos"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/appBarTransactions"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- 2. Tarjeta Resumen Ejecutiva de Balance -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="BALANCE DEL FILTRO"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:letterSpacing="0.05"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnManageCatalogs"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="⚙ Cuentas"
                            android:textSize="11sp"
                            android:textColor="@color/text_primary"
                            android:background="@drawable/bg_input_field"
                            android:paddingHorizontal="14dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTotalBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="+$0.00"
                        android:textColor="@color/success"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <!-- Desglose de Totales: Ingresos / Gastos / Movs -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:gravity="center"
                                android:text="↓"
                                android:textColor="@color/income_green"
                                android:background="@drawable/bg_input_field"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ingresos"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tvFilterIncome"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="+$0.00"
                                    android:textColor="@color/income_green"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:gravity="center"
                                android:text="↑"
                                android:textColor="@color/expense_red"
                                android:background="@drawable/bg_input_field"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Gastos"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tvFilterExpense"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-$0.00"
                                    android:textColor="@color/expense_red"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:gravity="center"
                                android:text="🧾"
                                android:textSize="11sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Movs."
                                    android:textColor="@color/text_secondary"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tvFilterCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Caja de Búsqueda y Filtros Integrados -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/card"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <EditText
                        android:id="@+id/etTxSearch"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="🔍 Buscar por concepto, categoría o monto..."
                        android:textColorHint="@color/text_secondary"
                        android:textColor="@color/text_primary"
                        android:inputType="text"
                        android:paddingHorizontal="14dp"
                        android:textSize="12sp" />

                    <!-- Fila 1: Filtro por Tipo (Todos / Gastos / Ingresos) en 3 columnas iguales -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <Button
                            android:id="@+id/btnFilterAll"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Todos"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_primary_button" />

                        <Button
                            android:id="@+id/btnFilterExpense"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Gastos"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            android:textColor="@color/text_secondary"
                            android:background="@drawable/bg_input_field" />

                        <Button
                            android:id="@+id/btnFilterIncome"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Ingresos"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            android:textColor="@color/text_secondary"
                            android:background="@drawable/bg_input_field" />
                    </LinearLayout>

                    <!-- Fila 2: Filtro por Período y Fecha (Todo / Hoy / Este Mes / Por Fecha 📅) -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none"
                        android:clipToPadding="false">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <Button
                                android:id="@+id/btnPeriodAll"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Todo"
                                android:textSize="11sp"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/bg_primary_button"
                                android:paddingHorizontal="14dp" />

                            <Button
                                android:id="@+id/btnPeriodToday"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Hoy"
                                android:textSize="11sp"
                                android:textAllCaps="false"
                                android:textColor="@color/text_secondary"
                                android:background="@drawable/bg_input_field"
                                android:layout_marginStart="6dp"
                                android:paddingHorizontal="14dp" />

                            <Button
                                android:id="@+id/btnPeriodMonth"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Este Mes"
                                android:textSize="11sp"
                                android:textAllCaps="false"
                                android:textColor="@color/text_secondary"
                                android:background="@drawable/bg_input_field"
                                android:layout_marginStart="6dp"
                                android:paddingHorizontal="14dp" />

                            <Button
                                android:id="@+id/btnPickFilterDate"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Por Fecha 📅"
                                android:textSize="11sp"
                                android:textAllCaps="false"
                                android:textColor="@color/text_secondary"
                                android:background="@drawable/bg_input_field"
                                android:layout_marginStart="6dp"
                                android:paddingHorizontal="14dp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Fila 3: Filtros por Cuentas y Categorías -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none"
                        android:clipToPadding="false">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:id="@+id/containerAccountFilters"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />

                            <LinearLayout
                                android:id="@+id/containerCategoryFilters"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Encabezado de Lista: "Historial de Movimientos" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Historial de Movimientos"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBadgeTotalRegistros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 registros"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:text="Toca cualquier transacción para ver su comprobante detallado"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- 5. Lista de Transacciones -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>

    <!-- Botón Píldora Flotante "+ Nuevo" (Idéntico a Screenshot 2) -->
    <Button
        android:id="@+id/btnNewTransactionPill"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="＋  Nuevo"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:background="@drawable/bg_primary_button"
        android:paddingHorizontal="22dp"
        android:elevation="6dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="74dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barra de Navegación Inferior -->
    <include
        layout="@layout/bottom_nav_bar"
        android:layout_width="0dp"
        android:layout_height="62dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
