<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos de Red y Notificaciones -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".FinanzasApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FinanzasUDB">

        <!-- Pantalla de Login como punto de entrada -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantallas del ecosistema registradas como AppCompatActivity -->
        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false"
            android:label="@string/title_register" />

        <activity
            android:name=".ui.DashboardActivity"
            android:exported="false"
            android:label="@string/title_dashboard" />

        <activity
            android:name=".ui.TransactionsActivity"
            android:exported="false"
            android:label="@string/title_transactions" />

        <activity
            android:name=".ui.BudgetsActivity"
            android:exported="false"
            android:label="@string/title_budgets" />

        <activity
            android:name=".ui.ScheduleActivity"
            android:exported="false"
            android:label="@string/title_schedule" />

        <activity
            android:name=".ui.NewsActivity"
            android:exported="false"
            android:label="@string/title_news" />

        <activity
            android:name=".ui.ProfileActivity"
            android:exported="false"
            android:label="@string/title_profile" />

        <!-- Receiver para recordatorios programados de inicio de clase -->
        <receiver
            android:name=".utils.ClassNotificationReceiver"
            android:exported="false" />

    </application>

</manifest>
